# ==========================================
# VK Messages — Production Environment
# ==========================================
# Copy this file to .env and fill in your values
# before deploying to production.

# ---- Database ----
# For Vercel + Supabase: use your Supabase connection string
# Example: postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/vk-messages

# ---- Security ----
# IMPORTANT: Change this to a long random string!
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-secret-in-production

# ---- App Settings ----
NODE_ENV=production
PORT=3000

# ---- Scheduler (for standalone scheduler service) ----
MAIN_APP_URL=http://app:3000
SCHEDULER_INTERVAL=60000
SCHEDULER_PORT=3003
